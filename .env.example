# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# REQUIRED. Comma-separated list of allowed browser origins.
# Vite dev server for the Electron renderer:
#   http://localhost:5173
# A packaged Electron app loading file:// sends the literal origin "null".
# Add "null" only if the renderer calls this API directly (see README).
ALLOWED_ORIGINS=http://localhost:5173

# "mock" is the default. Set to "groq" to use GroqCloud.
AI_PROVIDER=mock
AI_TIMEOUT_MS=30000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

REQUEST_BODY_LIMIT=64kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20
DAILY_RATE_LIMIT_MAX=1200
MONGODB_URI=
MONGODB_DATABASE=agentjunkcleaner
# Set to the number of trusted reverse-proxy hops when deployed behind a proxy.
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
