{
  "name": "agentjunkcleaner-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AI dialogue + tool-call backend for AgentJunkCleaner",
  "main": "dist/server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
